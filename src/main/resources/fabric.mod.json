{
  "schemaVersion": 1,
  "id": "nora-tweaks",
  "version": "${version}",
  "name": "Nora Tweaks",
  "description": "A tweaks mod for Meteor Client.",
  "authors": [
    "noramibu",
    "Fractal42O"
  ],
  "contact": {
    "sources": "https://github.com/noramibu/Nora-Tweaks"
  },
  "icon": "assets/nora-tweaks/icon.png",
  "environment": "client",
  "entrypoints": {
    "mixinsquared": [
      "me.noramibu.tweaks.RejectsBaritoneCancel"
    ],
    "meteor": [
      "me.noramibu.tweaks.NoraTweaks"
    ]
  },
  "mixins": [
    "nora-tweaks.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=25",
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "meteor-client": "*"
  }
}
